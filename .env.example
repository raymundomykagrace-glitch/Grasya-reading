# ---------------------------------------------------------------------------
# GENERATION_MODE picks how the server talks to Claude:
#
#   cli  - shells out to the `claude` CLI, using an existing Claude Code /
#          Claude.ai subscription login (Pro, Max, or Team). No separate
#          billed API key needed. Requires:
#            1. npm install -g @anthropic-ai/claude-code
#            2. run `claude` once and log in with your Claude.ai account
#          No token-level streaming — the full page is written once it's done
#          generating (can take 30-90+ seconds for longer pages).
#
#   api  - calls the Anthropic Messages API directly with ANTHROPIC_API_KEY
#          (see console.anthropic.com). Billed separately, per token, from any
#          claude.ai subscription. Supports live token-by-token streaming.
# ---------------------------------------------------------------------------
GENERATION_MODE=cli

# Only used when GENERATION_MODE=api. Get one at https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Only used when GENERATION_MODE=api. Verify the exact model id against your
# Anthropic console/docs before deploying — model ids change over time and a
# stale id will make every request fail.
CLAUDE_MODEL=claude-sonnet-4-6

# Only used when GENERATION_MODE=cli. Accepts an alias (sonnet, opus, haiku,
# fable) or a full model id. Aliases are recommended here since they keep
# working as Anthropic updates which model each alias points to.
CLAUDE_CLI_MODEL=sonnet

# Port the Express server listens on.
PORT=3000

# Comma-separated list of origins allowed to call this API.
# Use "*" to allow any origin (fine for local development, not recommended for production).
ALLOWED_ORIGINS=*
