# Anthropic API key. Get one at https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Model to use for content generation.
# Verify the exact model id against your Anthropic console/docs before deploying —
# model ids change over time and a stale id will make every request fail.
CLAUDE_MODEL=claude-sonnet-4-6

# Port the Express server listens on.
PORT=3000

# Comma-separated list of origins allowed to call this API.
# Use "*" to allow any origin (fine for local development, not recommended for production).
ALLOWED_ORIGINS=*
